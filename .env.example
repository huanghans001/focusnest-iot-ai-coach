PROJECT_ID=focusnest_kelompok_13

MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=
MQTT_PASS=

WINDOW_SEC=2
DASHBOARD_PORT=8000

# Ambang batas (boleh disetel saat pengujian)
MOVE_RMS_THRESHOLD=0.7

# --- AI Coach (opsional, hanya dipakai detector.py di laptop; HP/Termux tidak butuh) ---
# Default mati: tanpa ini tidak ada data yang dikirim ke LLM dan saran dibuat dengan aturan sederhana.
LLM_ENABLED=false
LLM_PROVIDER=anthropic
# Isi dengan API key milikmu. JANGAN commit file .env (sudah ada di .gitignore).
LLM_API_KEY=
# Nama model boleh diganti sesuai akunmu (contoh nilai; tidak ditulis di kode)
LLM_MODEL=claude-haiku-5-5
